# ==============================================================================
# ArrClean — Automated Media Deduplication & Lifecycle Manager Configuration
# ==============================================================================

# ── General & Safety ─────────────────────────────────────────────────────────
# When true, scans and checks identify duplicates without deleting any files.
ARRCLEAN_DRY_RUN=true

# Database Connection:
# SQLite (default, zero-config): sqlite+aiosqlite:///./data/arrclean.db
# PostgreSQL: postgresql+asyncpg://user:pass@postgres:5432/arrclean
ARRCLEAN_DATABASE_URL=sqlite+aiosqlite:///./data/arrclean.db

# Log level: DEBUG, INFO, WARNING, ERROR
ARRCLEAN_LOG_LEVEL=INFO

# ── Scheduling ───────────────────────────────────────────────────────────────
# Cron expression for full library scan (default: 3 AM daily)
ARRCLEAN_SCAN_CRON=0 3 * * *

# Interval in minutes between qBittorrent seed-lock checks
ARRCLEAN_SEED_MONITOR_INTERVAL_MINUTES=30

# Interval in minutes between download queue interception runs
ARRCLEAN_QUEUE_CHECK_INTERVAL_MINUTES=15

# ── qBittorrent Seeding & Hardlink Retention Rules ───────────────────────────
# Minimum share ratio before an inferior duplicate torrent may be purged
ARRCLEAN_MIN_SEED_RATIO=1.0

# Minimum seeding time in days before an inferior duplicate torrent may be purged
ARRCLEAN_MIN_SEED_DAYS=90

# Whether to consolidate multiple cuts (e.g. Director's Cut vs Theatrical) as duplicates
ARRCLEAN_EDITION_CONSOLIDATE=true

# ── Quality Scoring Weights (0.0 to 2.0) ──────────────────────────────────────
ARRCLEAN_WEIGHT_RESOLUTION=1.0
ARRCLEAN_WEIGHT_HDR=1.0
ARRCLEAN_WEIGHT_SOURCE=1.0
ARRCLEAN_WEIGHT_AUDIO=1.0
ARRCLEAN_WEIGHT_CODEC=1.0

# ── Connected Services ───────────────────────────────────────────────────────
# Plex Media Server
ARRCLEAN_PLEX_URL=http://192.168.1.50:32400
ARRCLEAN_PLEX_TOKEN=your_plex_token_here

# Radarr (Movies)
ARRCLEAN_RADARR_URL=http://192.168.1.50:7878
ARRCLEAN_RADARR_APIKEY=your_radarr_api_key_here

# Sonarr (TV Shows)
ARRCLEAN_SONARR_URL=http://192.168.1.50:8989
ARRCLEAN_SONARR_APIKEY=your_sonarr_api_key_here

# qBittorrent (Torrents)
ARRCLEAN_QBITTORRENT_URL=http://192.168.1.50:8080
ARRCLEAN_QBITTORRENT_USERNAME=admin
ARRCLEAN_QBITTORRENT_PASSWORD=adminadmin

# SABnzbd (Usenet)
ARRCLEAN_SABNZBD_URL=http://192.168.1.50:8085
ARRCLEAN_SABNZBD_APIKEY=your_sabnzbd_api_key_here

# Overseerr / Jellyseerr
ARRCLEAN_OVERSEERR_URL=http://192.168.1.50:5055
ARRCLEAN_OVERSEERR_APIKEY=your_overseerr_api_key_here

# Prowlarr (Indexer Manager)
ARRCLEAN_PROWLARR_URL=http://192.168.1.50:9696
ARRCLEAN_PROWLARR_APIKEY=your_prowlarr_api_key_here

# ── Webhook Notifications ────────────────────────────────────────────────────
# Discord Webhook
ARRCLEAN_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Notifiarr API Key
ARRCLEAN_NOTIFIARR_APIKEY=

# Gotify Server
ARRCLEAN_GOTIFY_URL=https://gotify.example.com
ARRCLEAN_GOTIFY_TOKEN=
